      <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Manage Session State" enabled="true">
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="parameters"></stringProp>
        <stringProp name="script">// Run after every sampler in this Thread Group, but act only for selected URLs

def sampler = prev.getSampleLabel()
def path = prev.getURL()?.getPath()
if (path == null) return

log.debug(&quot;[SESSION] sampler: ${sampler}, context: ${path}&quot;)

// 1) Filter: only URLs containing a specific context/path fragment
if (path.equals(&quot;/maximo/ui/&quot;)) {
	// 2) Extract from response body
	def body = prev.getResponseDataAsString()
	if (!body) return

	// Example: extract values
	def mToken = (body =~ /CSRFTOKEN = &quot;(\w+)&quot;/)
	if (mToken.find()) {
		def token = mToken.group(1)
		log.debug(&quot;[SESSION] token: ${token}&quot;)
		vars.put(&quot;csrftoken&quot;, token)
	}

	def mSsId = (body =~ /UISESSIONID = decodeURIComponent\(&quot;(\w+)&quot;\)/)
	if (mSsId.find()) {
		def ssId = mSsId.group(1)
		log.debug(&quot;[SESSION] uisession: ${ssId}&quot;)
		vars.put(&quot;uisessionid&quot;, ssId)
	}

	def mPageSeq = (body =~ /PAGESEQNUM = &quot;(\w+)&quot;/)
	if (mPageSeq.find()) {
		def pageSeq = mPageSeq.group(1)
		log.debug(&quot;[SESSION] pageseqnum: ${pageSeq}&quot;)
		vars.put(&quot;pageseqnum&quot;, pageSeq)
		vars.put(&quot;xhrseqnum&quot;, &quot;1&quot;)
	} else {
		def xhrSeqNum = (vars.get(&quot;xhrseqnum&quot;) ?: &quot;0&quot;) as int + 1
		vars.put(&quot;xhrseqnum&quot;, xhrSeqNum.toString())
		log.debug(&quot;[SESSION] xhrseqnum: ${xhrSeqNum}&quot;)
	}
} else if (path.endsWith(&quot;/maximo.jsp&quot;)) {
	def xhrSeqNum = (vars.get(&quot;xhrseqnum&quot;) ?: &quot;0&quot;) as int + 1
	vars.put(&quot;xhrseqnum&quot;, xhrSeqNum.toString())
	log.debug(&quot;[SESSION] xhrseqnum: ${xhrSeqNum}&quot;)

	// Detect session handling errors
	def body = prev.getResponseDataAsString()
	if (body?.contains(&quot;exit.jsp?sharedSession=1&quot;)) {
	    prev.setSuccessful(false)
	    prev.setResponseMessage(&quot;Detected forced logout: exit.jsp?sharedSession=1&quot;)
	    log.warn(&quot;[SESSION] sampler: ${sampler} - shared session error&quot;)
	}
}
</stringProp>
        <stringProp name="scriptLanguage">groovy</stringProp>
      </JSR223PostProcessor>
