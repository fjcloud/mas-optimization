{%- set raise_rows = recs.rows | selectattr('action', 'in', ['raise-cpu', 'raise-mem']) | list -%}
{%- set ok_rows = recs.rows | rejectattr('action', 'in', ['raise-cpu', 'raise-mem']) | list -%}
{%- set fmt = '%-22s %-22s %-18s %-18s %s' -%}
{%- set hdr = fmt | format('CONTAINER', 'NAMESPACE', 'CURRENT', 'RECOMMENDED', 'PATCH') -%}
{%- set rule = '-' * 100 -%}
{%- if raise_rows | length > 0 %}
Raise requests — a CR patch is written for these
{{ hdr }}
{{ rule }}
{% for row in raise_rows %}
{{ fmt | format(row.container, row.namespace, row.current, row.target, 'raise CPU' if row.action == 'raise-cpu' else 'raise memory') }}
{% endfor %}
{% else %}
No request raises.
{% endif %}
{%- if ok_rows | length > 0 %}

Already OK — no patch
{{ hdr }}
{{ rule }}
{% for row in ok_rows %}
{{ fmt | format(row.container, row.namespace, row.current, row.target, 'no') }}
{% endfor %}
{% endif %}
{%- if recs.manage.needed | bool %}

Manage serverBundles is one shared request for every bundle. Patch: {{ recs.manage.cpu }} / {{ recs.manage.memory }}
{% endif %}
